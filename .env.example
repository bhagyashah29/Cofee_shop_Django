# Flask/SQLAlchemy
SECRET_KEY=change-this-secret
DATABASE_URL=sqlite:////workspace/app.db

# External APIs
RESTCOUNTRIES_API_URL=https://restcountries.com/v3.1/all?fields=name,currencies
EXCHANGE_RATE_API_BASE_URL=https://api.exchangerate-api.com/v4/latest

# File uploads / OCR
UPLOAD_FOLDER=/workspace/uploads
MAX_CONTENT_LENGTH_MB=10
OCR_ENABLED=true
# If tesseract is installed in another path, override here
TESSERACT_CMD=/usr/bin/tesseract
